---
import { Icon } from "astro-icon/components";
---

<div id="language-select">
  <a href="/ja/about">日本語<Icon name="right" width="14" height="14" /></a>
  <a href="/en/about">English<Icon name="right" width="14" height="14" /></a>
</div>

<style>
  #language-select {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.25rem;
    align-items: baseline;

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      color: black;
      border: 1px solid rgba(0, 0, 0, 0.6);
      gap: 0.6rem;
      border-radius: 0.6rem;
      text-decoration: none;
      padding: 0.3rem 1rem 0.3rem 1.5rem;
      margin-bottom: 1rem;
      line-height: 2rem;
      font-size: 0.8rem;
      transition: all 0.3s ease-in-out;
    }

    a:hover {
      color: white;
      background-color: black;
    }
  }
</style>
