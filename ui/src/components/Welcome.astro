---
import storefront from "../assets/storefront.webp";

interface Props {
  big?: boolean;
  titleImage: ImageMetadata;
  titleAlt?: string;
  storefrontAlt?: string;
}

const {
  big = false,
  titleImage,
  titleAlt,
  storefrontAlt,
} = Astro.props as Props;
---

<section
  id="storefront-container"
  class={big ? "big" : ""}
  transition:name="storefront-container"
>
  <div id="title-container" transition:name="title-container">
    <a href="/">
      <img
        id="title"
        src={titleImage.src}
        alt={titleAlt}
        transition:name="title"
      />
    </a>
  </div>

  <img
    id="storefront"
    src={storefront.src}
    alt={storefrontAlt}
    transition:name="storefront"
  />
</section>

<style>
  #storefront-container {
    display: grid;
    align-items: center;

    #storefront,
    #title-container {
      grid-row: 1;
      grid-column: 1;

      border-radius: 12px;
      width: 100%;
    }

    #storefront {
      height: 22vh;
      object-fit: cover;
      box-shadow: 0px 0px 30px rgba(0, 0, 0, 0.2);
    }

    #title-container {
      width: 100%;

      backdrop-filter: blur(4px);
      z-index: 1;

      display: flex;
      justify-content: center;
      align-items: center;

      #title {
        height: 16vw;
      }
    }
  }

  #storefront-container.big {
    #storefront {
      height: 80vw;
    }

    #title-container {
      --title-height: 20vw;
    }
  }
</style>
